# [[sfs::...]] attributes are the engine's: sfs-codegen reads them and sfs-lsp
# checks them. Clang can only silence unknown attributes all together; sfs-lsp
# reports misspelt standard ones instead.
Diagnostics:
  Suppress: [unknown-attributes]
  # SFS's own: include what you use. Flag an include nothing uses, and a name
  # that only arrives through another header. (New projects keep clangd's
  # default.)
  UnusedIncludes: Strict
  MissingIncludes: Strict
