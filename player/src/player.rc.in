// Windows resources of SfsPlayer (and so of every exported game): its version
// information (Properties > Details in Explorer) and, when the build is given
// one (SFS_PLAYER_ICON), its icon. Configured by player/CMakeLists.txt.
#include <winver.h>

@SFS_PLAYER_ICON_RESOURCE@

1 VERSIONINFO
FILEVERSION @SFS_PLAYER_VERSION_COMMAS@
PRODUCTVERSION @SFS_PLAYER_VERSION_COMMAS@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Game made with the Segfault Simulator engine\0"
            VALUE "FileVersion", "@SFS_PLAYER_VERSION@\0"
            VALUE "ProductName", "Segfault Simulator Player\0"
            VALUE "ProductVersion", "@SFS_PLAYER_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
