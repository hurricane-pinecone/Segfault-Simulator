# _sfs_force_include: every file of <target> includes <header> first.
function(_sfs_force_include target header)
    target_compile_options(${target} PRIVATE
        "SHELL:$<IF:$<CXX_COMPILER_ID:MSVC>,/FI,-include> \"${header}\"")
endfunction()

# _sfs_configure_event_traits: a target's event traits header as it's
# configured, so an editor's language server compiles its files before the
# first build. With a codegen executable at hand (an installed engine, a
# cross build) it's the real header; in a native build, whose codegen isn't
# built yet, it's one with no event types. Either way its stamp goes, so the
# build's codegen runs and writes the real one: a header written here never
# stands for the build's.
function(_sfs_configure_event_traits traits stamp)
    if(EXISTS "${traits}")
        return()
    endif()
    file(REMOVE "${stamp}")
    if(SFS_CODEGEN_COMMAND AND EXISTS "${SFS_CODEGEN_COMMAND}")
        execute_process(
            COMMAND "${SFS_CODEGEN_COMMAND}" --events-only --event-traits "${traits}" ${ARGN}
            RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
        if(result EQUAL 0 AND EXISTS "${traits}")
            return()
        endif()
    endif()
    file(WRITE "${traits}"
        "// Generated by sfs-codegen at the build; until then, no event types.\n"
        "#pragma once\n\n#include <engine/core/events/eventTraits.h>\n")
endfunction()

# sfs_generate_reflection: run sfs-codegen over script headers and compile the
# generated registration into a target. The same scan writes the headers'
# event traits (the compile-time kinds, responses and ancestors of their
# [[sfs::event_...]] types), which every file of the target includes first.
#
#   sfs_generate_reflection(<target>
#       MODULE <name>              # stored on each registered type
#       FUNCTION <qualified-name>  # registration function to define
#       HEADERS <header>...        # one script type per header
#       [FUNCTION_HEADER <header>] # declares FUNCTION (default: reflection.h)
#       [INCLUDE_ROOT <dir>]       # include headers relative to this
#       [EVENT_SOURCES <file>...]  # other files declaring event types (.cpp,
#                                  # or headers scanned for events alone)
#       [EVENT_TRAITS <header>]    # write the event traits here, included by
#                                  # engine/core/events/eventTraits.h rather
#                                  # than by every file (the engine's own)
#       [NO_EVENT_TRAITS])         # the headers declare no event types
#
# The tool is SFS_CODEGEN_COMMAND: the in-tree sfs-codegen target in a native
# build, or the host executable in SFS_CODEGEN_EXECUTABLE when cross-compiling.
# Against an installed engine, engineConfig.cmake sets it up.
function(sfs_generate_reflection target)
    cmake_parse_arguments(ARG "NO_EVENT_TRAITS" "MODULE;FUNCTION;FUNCTION_HEADER;INCLUDE_ROOT;EVENT_TRAITS" "HEADERS;EVENT_SOURCES" ${ARGN})

    set(output "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}Reflection.gen.cpp")
    # The command's output is a stamp it always touches: the files it writes
    # only when they change (so nothing recompiles needlessly) are byproducts,
    # and a source edited without changing them doesn't rerun it later.
    set(stamp "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}Reflection.stamp")
    set(args --module "${ARG_MODULE}" --function "${ARG_FUNCTION}" --output "${output}")
    set(written "${output}")
    if(NOT ARG_NO_EVENT_TRAITS)
        if(ARG_EVENT_TRAITS)
            set(traits "${ARG_EVENT_TRAITS}")
        else()
            set(traits "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}EventTraits.gen.h")
        endif()
        list(APPEND args --event-traits "${traits}")
        list(APPEND written "${traits}")
        foreach(source ${ARG_EVENT_SOURCES})
            list(APPEND args --event-source "${source}")
        endforeach()
        _sfs_configure_event_traits("${traits}" "${stamp}" ${ARG_HEADERS} ${ARG_EVENT_SOURCES})
    endif()
    # A written file missing (deleted by hand) needs the command to run.
    foreach(file ${written})
        if(NOT EXISTS "${file}")
            file(REMOVE "${stamp}")
        endif()
    endforeach()
    if(ARG_FUNCTION_HEADER)
        list(APPEND args --function-header "${ARG_FUNCTION_HEADER}")
    endif()
    if(ARG_INCLUDE_ROOT)
        list(APPEND args --include-root "${ARG_INCLUDE_ROOT}")
    endif()

    add_custom_command(
        OUTPUT "${stamp}"
        BYPRODUCTS ${written}
        COMMAND ${SFS_CODEGEN_COMMAND} ${args} ${ARG_HEADERS}
        COMMAND ${CMAKE_COMMAND} -E touch "${stamp}"
        DEPENDS ${SFS_CODEGEN_DEPENDS} ${ARG_HEADERS} ${ARG_EVENT_SOURCES}
        COMMENT "Generating reflection for ${target}"
        VERBATIM)
    target_sources(${target} PRIVATE "${stamp}" ${written})
    if(NOT ARG_NO_EVENT_TRAITS AND NOT ARG_EVENT_TRAITS)
        _sfs_force_include(${target} "${traits}")
    endif()
endfunction()

# sfs_event_traits: the event traits of the event types declared in any
# source files (a test's .cpp), included first by every file of <target>.
#
#   sfs_event_traits(<target> FILES <file>...)
function(sfs_event_traits target)
    cmake_parse_arguments(ARG "" "" "FILES" ${ARGN})
    set(traits "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}EventTraits.gen.h")
    set(stamp "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}EventTraits.stamp")
    _sfs_configure_event_traits("${traits}" "${stamp}" ${ARG_FILES})
    add_custom_command(
        OUTPUT "${stamp}"
        BYPRODUCTS "${traits}"
        COMMAND ${SFS_CODEGEN_COMMAND} --events-only --event-traits "${traits}" ${ARG_FILES}
        COMMAND ${CMAKE_COMMAND} -E touch "${stamp}"
        DEPENDS ${SFS_CODEGEN_DEPENDS} ${ARG_FILES}
        COMMENT "Generating event traits for ${target}"
        VERBATIM)
    target_sources(${target} PRIVATE "${stamp}" "${traits}")
    _sfs_force_include(${target} "${traits}")
endfunction()

# GCC 13 before 13.3 on MinGW (GCC PR 110572): in C++23, <typeinfo> defines
# std::type_info::operator== inline, so an unoptimised build (the UI Preview
# module, a Debug module) emits a copy of it, which clashes with the one in
# the libstdc++.a that modules link statically. They're the same function, so
# the linker may keep either.
function(_sfs_allow_typeinfo_duplicate target)
    if(MINGW AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND
       CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 13 AND
       CMAKE_CXX_COMPILER_VERSION VERSION_LESS 13.3)
        target_link_options(${target} PRIVATE -Wl,--allow-multiple-definition)
    endif()
endfunction()

# sfs_add_game_module: build a project's scripts into a game module -- the
# shared library the editor loads (and reloads) to run them.
#
#   sfs_add_game_module(<name> [SCRIPTS_DIR <dir>])
#
# Every header in SCRIPTS_DIR (default: ./scripts) is scanned by sfs-codegen;
# every .cpp there is compiled in. The module lands in <build>/module/, and
# exports only its entry point and the engine ABI it was built against (see
# engine/runtime/scripting/gameModule.h).
function(sfs_add_game_module name)
    cmake_parse_arguments(ARG "" "SCRIPTS_DIR" "" ${ARGN})
    if(NOT ARG_SCRIPTS_DIR)
        set(ARG_SCRIPTS_DIR "${CMAKE_CURRENT_SOURCE_DIR}/scripts")
    endif()

    file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${ARG_SCRIPTS_DIR}/*.h")
    file(GLOB_RECURSE sources CONFIGURE_DEPENDS "${ARG_SCRIPTS_DIR}/*.cpp")

    # The module's report of the engine it's built against (see
    # engine/runtime/scripting/gameModule.h), which loading it checks: one file
    # that defines it, compiled into the module and its UI preview.
    set(abi_source "${CMAKE_CURRENT_BINARY_DIR}/generated/${name}EngineAbi.gen.cpp")
    file(CONFIGURE OUTPUT "${abi_source}" CONTENT
        "// Generated: the engine ABI this module is built against.\n#include <engine/runtime/scripting/gameModule.h>\n\nSFS_DEFINE_MODULE_ENGINE_ABI()\n")

    add_library(${name} SHARED ${sources} "${abi_source}")
    target_link_libraries(${name} PRIVATE sfs::engine)
    target_include_directories(${name} PRIVATE "${ARG_SCRIPTS_DIR}")
    target_compile_definitions(${name} PRIVATE SFS_GAME_MODULE)
    set_target_properties(${name} PROPERTIES
        PREFIX ""
        CXX_VISIBILITY_PRESET hidden
        VISIBILITY_INLINES_HIDDEN ON
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/module"
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/module")
    _sfs_allow_typeinfo_duplicate(${name})

    sfs_generate_reflection(${name}
        MODULE ${name}
        FUNCTION sfsRegisterModule
        FUNCTION_HEADER engine/runtime/scripting/gameModule.h
        INCLUDE_ROOT "${ARG_SCRIPTS_DIR}"
        HEADERS ${headers}
        EVENT_SOURCES ${sources})

    # The editor's UI Preview module: the UI files (*.ui.cpp) and a preview
    # of each view in the UI headers (*.ui.h), filled with placeholders. Only
    # built when asked for (the editor does, as UI files are saved): it's
    # unoptimised, with the engine's headers precompiled, to build in seconds,
    # and loads apart from the game module, which stays as it is.
    file(GLOB_RECURSE ui_headers CONFIGURE_DEPENDS "${ARG_SCRIPTS_DIR}/*.ui.h")
    file(GLOB_RECURSE ui_sources CONFIGURE_DEPENDS "${ARG_SCRIPTS_DIR}/*.ui.cpp")
    set(preview ${name}UiPreview)
    set(preview_source "${CMAKE_CURRENT_BINARY_DIR}/generated/${preview}.gen.cpp")
    # A stamp, as for the reflection: codegen writes the source only when it
    # changes.
    set(preview_stamp "${CMAKE_CURRENT_BINARY_DIR}/generated/${preview}.stamp")
    if(NOT EXISTS "${preview_source}")
        file(REMOVE "${preview_stamp}")
    endif()
    add_custom_command(
        OUTPUT "${preview_stamp}"
        BYPRODUCTS "${preview_source}"
        COMMAND ${SFS_CODEGEN_COMMAND} --ui-previews
                --module ${preview} --function sfsRegisterModule
                --include-root "${ARG_SCRIPTS_DIR}"
                --output "${preview_source}" ${ui_headers}
        COMMAND ${CMAKE_COMMAND} -E touch "${preview_stamp}"
        DEPENDS ${SFS_CODEGEN_DEPENDS} ${ui_headers}
        COMMENT "Generating UI previews for ${name}"
        VERBATIM)
    add_library(${preview} SHARED EXCLUDE_FROM_ALL ${ui_sources} "${preview_stamp}" "${preview_source}" "${abi_source}")
    # The module's event traits too, as UI files may include its headers: in
    # the precompiled headers, which come before any code (a header forced in
    # ahead of them would keep the compiler from using them).
    set(module_traits "${CMAKE_CURRENT_BINARY_DIR}/generated/${name}EventTraits.gen.h")
    target_sources(${preview} PRIVATE
        "${CMAKE_CURRENT_BINARY_DIR}/generated/${name}Reflection.stamp"
        "${module_traits}")
    target_link_libraries(${preview} PRIVATE sfs::engine)
    target_include_directories(${preview} PRIVATE "${ARG_SCRIPTS_DIR}")
    target_compile_definitions(${preview} PRIVATE SFS_GAME_MODULE)
    # After the build type's flags, so it wins.
    target_compile_options(${preview} PRIVATE $<IF:$<CXX_COMPILER_ID:MSVC>,/Od,-O0>)
    target_precompile_headers(${preview} PRIVATE <sfs/sfs.h> <functional> <string> <vector>
                              "${module_traits}")
    set_target_properties(${preview} PROPERTIES
        PREFIX ""
        CXX_VISIBILITY_PRESET hidden
        VISIBILITY_INLINES_HIDDEN ON
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/ui-preview"
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/ui-preview")
    _sfs_allow_typeinfo_duplicate(${preview})

    # clangd (and most editors) look for the compile database in the project:
    # link it at <project>/.sfs/compile_commands.json, which the project's
    # .clangd points to. CMake writes the database itself at generate time.
    if(CMAKE_EXPORT_COMPILE_COMMANDS)
        file(MAKE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/.sfs")
        file(CREATE_LINK "${CMAKE_BINARY_DIR}/compile_commands.json"
             "${CMAKE_CURRENT_SOURCE_DIR}/.sfs/compile_commands.json"
             RESULT link_result SYMBOLIC)
        if(NOT link_result EQUAL 0)
            message(STATUS "Couldn't link compile_commands.json into ${CMAKE_CURRENT_SOURCE_DIR}/.sfs: ${link_result}")
        endif()
    endif()
endfunction()
